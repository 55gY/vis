; wwflt.inf -- WWFilter minifilter driver install file.
;
; Install (testsigning on, or a properly signed build).
; NOTE: rundll32 InstallHinfSection has a quirk -- it stores
; ServiceBinary as a RELATIVE path (system32\DRIVERS\wwflt.sys),
; which makes `fltmc load` fail with 0x80070002. Prefer one of:
;   pnputil /add-driver wwflt.inf /install
;     (expands DIRIDs correctly; then `fltmc load wwflt`), or
;   copy wwflt.sys to C:\Windows\System32\drivers\ and
;     sc create WWFilter type= kernel binPath= C:\Windows\System32\drivers\wwflt.sys
;     (note the space after binPath=), then `sc start WWFilter`.
;   If you already installed via rundll32 and the service path is
;   relative, fix it with:
;     sc config WWFilter binPath= C:\Windows\System32\drivers\wwflt.sys
; Then load:
;   fltmc load wwflt   (or sc start WWFilter if fltmc still errors)
; Unload / uninstall:
;   fltmc unload wwflt
;   rundll32.exe setupapi,InstallHinfSection DefaultUninstall 132 .\wwflt.inf
;
; Altitude 141000 sits in the FSFilter Encryption range (140000-149999).
; It is a development value; a production altitude must be allocated by
; Microsoft (https://learn.microsoft.com/en-us/windows-hardware/drivers/ifs/allocating-altitudes).

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %Provider%
DriverVer   = 11/11/2026,1.0.0.0
CatalogFile = wwflt.cat

[DestinationDirs]
DefaultDestDir = 12

[DefaultInstall]
OptionDesc = %ServiceDesc%
CopyFiles  = @wwflt.sys

[DefaultInstall.Services]
AddService = WWFilter, , WWFilter.Service

[DefaultUninstall]
DelFiles   = @wwflt.sys

[DefaultUninstall.Services]
DelService = WWFilter, 0x200

[WWFilter.Service]
DisplayName    = %ServiceDesc%
Description    = %ServiceDesc%
ServiceType    = 2    ; FILE_SYSTEM_DRIVER
StartType      = 3    ; SERVICE_DEMAND_START (fltmc load)
ErrorControl   = 1    ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\wwflt.sys
LoadOrderGroup = "FSFilter Encryption"
Dependencies   = FltMgr
AddReg         = WWFilter.AddReg

[WWFilter.AddReg]
HKR, "Instances", "DefaultInstance", 0x00000000, %InstanceName%
HKR, "Instances\%InstanceName%", "Altitude", 0x00000000, "141000"
HKR, "Instances\%InstanceName%", "Flags", 0x00010001, 0x0

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
wwflt.sys = 1,,

[Strings]
Provider     = "WWFilter"
ServiceDesc  = "WWFilter transparent file encryption filter"
InstanceName = "WWFilter Instance"
DiskName     = "WWFilter install media"
